# Server Configuration
PORT=3000

# Groq LLM API Key (Get free key at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# ERP API Configuration (required — no fallback)
PURCHASE_API_URL=https://your-erp-domain.com/API/purchase_api.php
SALE_API_URL=https://your-erp-domain.com/API/sale_api.php
STOCK_API_URL=https://your-erp-domain.com/API/stock_api.php

# CORS: Add your production domain here (optional, in addition to the Vercel domain)
# ALLOWED_ORIGIN=https://your-custom-domain.com

# Admin Secret for protected endpoints (/api/refresh, /api/status/admin)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your_strong_random_secret_here
